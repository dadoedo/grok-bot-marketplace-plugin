# Operator env for hetzner-prod — copy to ~/grokbots/.env (chmod 600). Never commit.

# X API app-only Bearer (Developer Portal → App on a Project → Keys and tokens)
X_BEARER_TOKEN=

# Cloudflare (R2 upload)
# CLOUDFLARE_API_TOKEN=
# CF_ACCOUNT_ID=079006e0814dbf8ad1645014180e53f6

# R2 S3 API alternative
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# R2_BUCKET=grokbots-feed
# R2_KEY=feed.json
